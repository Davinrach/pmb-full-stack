PORT=8080
APP_ENV=development
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pmb_staici_db
JWT_SECRET=your-jwt-secret-key
UPLOAD_DIR=./uploads

# SMTP Email Configuration (misal: Gmail SMTP, Brevo, Mailgun, dll)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=email.pmb@staici.ac.id
SMTP_PASS=app_password_disini
SMTP_FROM=pmb@staici.ac.id
SMTP_FROM_NAME="PMB STAI Cendekia Insani"

# Kriptografi Data Pribadi (AES-256-GCM & Blind Index)
# Generate kunci baru dengan menjalankan: go run cmd/keygen/main.go
APP_ENC_KEYS=1:REPLACE_WITH_BASE64_32_BYTE_KEY_VERSION_1
APP_ENC_ACTIVE_VERSION=1
APP_BLIND_INDEX_KEY=REPLACE_WITH_BASE64_32_BYTE_BLIND_INDEX_KEY
